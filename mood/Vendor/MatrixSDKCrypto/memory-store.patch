+    /// Create a disposable machine using the SDK's official MemoryStore.
+    /// Exposed for offline integration checks; never use for persistent app sessions.
+    #[uniffi::constructor]
+    pub fn new_in_memory(user_id: String, device_id: String) -> Result<Arc<Self>, CryptoStoreError> {
+        let user_id = parse_user_id(&user_id)?;
+        let device_id = device_id.as_str().into();
+        let runtime = Runtime::new().expect("Couldn't create a tokio runtime");
+        let inner = runtime.block_on(InnerMachine::new(&user_id, device_id));
+        Ok(Arc::new(OlmMachine { inner: ManuallyDrop::new(inner), runtime }))
+    }
